[
  {
    "id": "claude-code",
    "platform": "linux",
    "command": "claude",
    "documentationUrl": "https://code.claude.com/docs/en/env-vars",
    "defaultStatus": "unknown",
    "ruleDefault": "unknown",
    "scope": ["usage telemetry", "error reporting", "provider"],
    "off": {"env": {"DISABLE_TELEMETRY": "1"}},
    "offStatus": "disabled",
    "offEvidence": ["env: DISABLE_TELEMETRY"],
    "fix": ["export DISABLE_TELEMETRY='1'"],
    "dnt": true,
    "examples": [
      {"name": "a nonessential-traffic opt-out also disables usage telemetry", "env": {"CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"}, "status": "disabled", "evidence": ["env: CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC"]},
      {"name": "an unclassified flag cannot prove telemetry is enabled", "env": {"DISABLE_TELEMETRY": "0"}, "status": "unknown"},
      {"name": "unrecognized values stay private and unknown", "env": {"DISABLE_TELEMETRY": "synthetic-private-value"}, "status": "unknown"},
      {"name": "Windows PATH uses executable extensions", "platform": "win32", "env": {"DISABLE_TELEMETRY": "1"}, "status": "disabled", "detection": ["PATH: claude"]}
    ]
  },
  {
    "id": "codex",
    "platform": "linux",
    "command": "codex",
    "documentationUrl": "https://developers.openai.com/codex/config-reference",
    "defaultStatus": "unknown",
    "ruleDefault": "unknown",
    "scope": ["TOML", "client", "OTLP"],
    "off": {"files": {"{home}/.codex/config.toml": "[analytics]\nenabled = false\n"}},
    "offStatus": "unknown",
    "offEvidence": ["default: unknown"],
    "fix": ["[analytics] enabled = false", "otel.metrics_exporter", "custom OTLP"],
    "manual": true,
    "configDetection": "{home}/.codex/config.toml",
    "examples": [
      {"name": "TOML enabling analytics cannot be parsed as JSON", "files": {"{home}/.codex/config.toml": "[analytics]\nenabled = true\n"}, "status": "unknown"},
      {"name": "custom CODEX_HOME does not justify interpreting the default file", "env": {"CODEX_HOME": "/fixture/other"}, "files": {"{home}/.codex/config.toml": "[analytics]\nenabled = false\n"}, "status": "unknown"},
      {"name": "malformed TOML remains unknown without exposing contents", "files": {"{home}/.codex/config.toml": "synthetic-private-value"}, "status": "unknown"}
    ]
  },
  {
    "id": "gemini-cli",
    "platform": "linux",
    "command": "gemini",
    "documentationUrl": "https://geminicli.com/docs/reference/configuration/",
    "defaultStatus": "unknown",
    "ruleDefault": "unknown",
    "scope": ["v0.3.0", "schema", "OpenTelemetry"],
    "off": {"files": {"{home}/.gemini/settings.json": "{\"privacy\":{\"usageStatisticsEnabled\":false}}"}},
    "offStatus": "unknown",
    "offEvidence": ["default: unknown"],
    "fix": ["privacy.usageStatisticsEnabled", "false", "version", "OpenTelemetry"],
    "manual": true,
    "configDetection": "{home}/.gemini/settings.json",
    "examples": [
      {"name": "legacy flat schema does not establish the installed version", "files": {"{home}/.gemini/settings.json": "{\"usageStatisticsEnabled\":false}"}, "status": "unknown"},
      {"name": "OpenTelemetry opt-out alone says nothing about usage statistics", "env": {"GEMINI_TELEMETRY_ENABLED": "false"}, "status": "unknown"},
      {"name": "malformed or unknown settings cannot prove an opt-out", "files": {"{home}/.gemini/settings.json": "{synthetic-private-value"}, "status": "unknown"}
    ]
  },
  {
    "id": "gh",
    "platform": "linux",
    "command": "gh",
    "documentationUrl": "https://cli.github.com/manual/gh_help_environment",
    "defaultStatus": "unknown",
    "ruleDefault": "unknown",
    "scope": ["Enterprise Server", "extensions", "version"],
    "off": {"env": {"GH_TELEMETRY": "false"}},
    "offStatus": "disabled",
    "offEvidence": ["env: GH_TELEMETRY"],
    "fix": ["export GH_TELEMETRY='false'"],
    "dnt": true,
    "examples": [
      {"name": "GH_TELEMETRY masks DNT even when the effective result is unconfirmed", "env": {"GH_TELEMETRY": "true", "DO_NOT_TRACK": "1"}, "status": "unknown", "evidence": ["env: GH_TELEMETRY"]},
      {"name": "explicit off takes precedence over DNT", "env": {"GH_TELEMETRY": "false", "DO_NOT_TRACK": "1"}, "status": "disabled", "evidence": ["env: GH_TELEMETRY"]},
      {"name": "unknown GH_TELEMETRY blocks DNT fallback", "env": {"GH_TELEMETRY": "synthetic-private-value", "DO_NOT_TRACK": "1"}, "status": "unknown", "evidence": ["env: GH_TELEMETRY"]}
    ]
  },
  {
    "id": "nextjs",
    "platform": "linux",
    "command": "next",
    "documentationUrl": "https://nextjs.org/telemetry",
    "defaultStatus": "unknown",
    "ruleDefault": "unknown",
    "scope": ["persisted", "project", "CLI"],
    "off": {"env": {"NEXT_TELEMETRY_DISABLED": "1"}},
    "offStatus": "disabled",
    "offEvidence": ["env: NEXT_TELEMETRY_DISABLED"],
    "fix": ["export NEXT_TELEMETRY_DISABLED='1'"],
    "examples": [
      {"name": "zero does not prove a persisted opt-out was removed", "env": {"NEXT_TELEMETRY_DISABLED": "0"}, "status": "unknown"},
      {"name": "unrecognized value remains unknown", "env": {"NEXT_TELEMETRY_DISABLED": "synthetic-private-value"}, "status": "unknown"},
      {"name": "project dependencies are outside the probe scope", "installed": false, "files": {"{home}/project/node_modules/.bin/next": "", "{home}/project/package.json": "{\"dependencies\":{\"next\":\"16.0.0\"}}"}, "absent": true}
    ]
  },
  {
