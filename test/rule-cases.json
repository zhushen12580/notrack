      {"name": "partial crash-only telemetry is not fully disabled", "files": {"{xdgConfig}/Code/User/settings.json": "{\"telemetry.telemetryLevel\":\"crash\"}"}, "status": "unknown"},
      {"name": "malformed user config remains unknown", "files": {"{xdgConfig}/Code/User/settings.json": "{synthetic-private-value"}, "status": "unknown"},
      {"name": "macOS default user config is detection evidence only", "platform": "darwin", "installed": false, "files": {"{home}/Library/Application Support/Code/User/settings.json": "{\"telemetry.telemetryLevel\":\"off\"}"}, "status": "unknown", "detection": ["config: {home}/Library/Application Support/Code/User/settings.json"]},
      {"name": "Windows default user config is detection evidence only", "platform": "win32", "installed": false, "files": {"{home}/AppData/Roaming/Code/User/settings.json": "{\"telemetry.telemetryLevel\":\"off\"}"}, "status": "unknown", "detection": ["config: {home}/AppData/Roaming/Code/User/settings.json"]}
    ]
  }
