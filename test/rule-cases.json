    "scope": ["1.61", "policy", "extensions"],
    "off": {"files": {"{xdgConfig}/Code/User/settings.json": "// synthetic user settings\n{\"telemetry.telemetryLevel\":\"off\"}"}},
    "offStatus": "unknown",
    "offEvidence": ["default: unknown"],
    "fix": ["telemetry.telemetryLevel", "off", "version", "policy", "extensions"],
    "manual": true,
    "configDetection": "{xdgConfig}/Code/User/settings.json",
    "examples": [
