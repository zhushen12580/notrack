# Optional environment reference for notrack. No credentials are required.
# notrack reads the inherited process environment; it does not automatically
# load .env files. Export chosen settings in your shell before running the CLI.
# Tool opt-outs affect only the telemetry scope documented in data/tools.json.
# Assignments apply to that shell and its child processes, not permanently.

# General controls: DNT affects only tools whose rules explicitly support it.
# DO_NOT_TRACK=1
# NO_COLOR=1
# NO_COLOR presence disables automatic color; --color / --no-color override it.

# Configuration discovery: use an absolute directory for XDG_CONFIG_HOME.
# When unset or relative, notrack uses the user's home directory plus .config.
# XDG_CONFIG_HOME=/absolute/path/to/config
# PATH locates installed tools; Windows also uses PATHEXT for extensions.
# Windows supplies SystemRoot to locate System32\reg.exe by absolute path.
# Missing or non-absolute SystemRoot leaves Windows registry results unknown.

# Tool-specific environment opt-outs recognized by the bundled rules.
# Claude Code (both options are supported; the second covers more traffic):
# DISABLE_TELEMETRY=1
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# GitHub CLI:
# GH_TELEMETRY=false
# Next.js:
# NEXT_TELEMETRY_DISABLED=1
# .NET SDK:
# DOTNET_CLI_TELEMETRY_OPTOUT=1
# Homebrew:
# HOMEBREW_NO_ANALYTICS=1
# Nuxt:
# NUXT_TELEMETRY_DISABLED=1
# Astro:
# ASTRO_TELEMETRY_DISABLED=1
# Angular CLI:
# NG_CLI_ANALYTICS=false
# Gatsby:
# GATSBY_TELEMETRY_DISABLED=1
# Turborepo:
# TURBO_TELEMETRY_DISABLED=1
# Vercel CLI:
# VERCEL_TELEMETRY_DISABLED=1
# Netlify CLI:
# NETLIFY_TELEMETRY_DISABLED=1
# Storybook:
# STORYBOOK_DISABLE_TELEMETRY=true
# Strapi:
# STRAPI_TELEMETRY_DISABLED=true
# Azure CLI:
# AZURE_CORE_COLLECT_TELEMETRY=0
# Azure Developer CLI:
# AZURE_DEV_COLLECT_TELEMETRY=no
# Google Cloud CLI:
# CLOUDSDK_CORE_DISABLE_USAGE_REPORTING=true
# AWS SAM CLI:
# SAM_CLI_TELEMETRY=0
# AWS CDK CLI:
# CDK_DISABLE_CLI_TELEMETRY=true
# Garden:
# GARDEN_DISABLE_ANALYTICS=true
# DevPod CLI:
# DEVPOD_DISABLE_TELEMETRY=true
# Fly CLI (overrides the saved analytics preference, including a prior true):
# FLY_SEND_METRICS=false
# vcpkg:
# VCPKG_DISABLE_METRICS=1
# Aider:
# AIDER_ANALYTICS_DISABLE=true
# PowerShell 7+ (set before launching pwsh):
# POWERSHELL_TELEMETRY_OPTOUT=1
